{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/.well-known/verify.pem",
      "headers": [
        { "key": "Content-Type",  "value": "application/x-pem-file" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/.well-known/verify-v1.pem",
      "headers": [
        { "key": "Content-Type",  "value": "application/x-pem-file" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/.well-known/revocation.txt",
      "headers": [
        { "key": "Content-Type",  "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    },
    {
      "source": "/.well-known/verification-policy.txt",
      "headers": [
        { "key": "Content-Type",  "value": "text/plain; charset=utf-8" },
        { "key": "Cache-Control", "value": "public, max-age=86400" }
      ]
    },
    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "celeste-homepage-webflow.vercel.app"
        }
      ],
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/prototypes/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(landing-v.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/companion",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/(seanet|seanet-overview|seanet-proposal|seanet-security|seanet-security-companion|seanet-euphoria|seanet-euphoria-overview|seanet-euphoria-proposal)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/(.*)",
      "has": [{ "type": "host", "value": "celeste-homepage-webflow.vercel.app" }],
      "destination": "https://celeste7.ai/$1",
      "permanent": true
    },
    { "source": "/handover", "destination": "/#handover", "permanent": true },
    { "source": "/search", "destination": "/#datum", "permanent": true },
    { "source": "/records", "destination": "/#ledger", "permanent": true },
    { "source": "/intelligence", "destination": "/#show-related", "permanent": true },
    { "source": "/faq", "destination": "/410.html", "statusCode": 410 },
    { "source": "/testimonials", "destination": "/410.html", "statusCode": 410 },
    { "source": "/user-settings", "destination": "/410.html", "statusCode": 410 },
    { "source": "/a-b-testing-start", "destination": "/410.html", "statusCode": 410 },
    { "source": "/pricing", "destination": "/410.html", "statusCode": 410 },
    { "source": "/basic-pricing", "destination": "/410.html", "statusCode": 410 },
    { "source": "/evolve-pricing", "destination": "/410.html", "statusCode": 410 },
    { "source": "/elevate-pricing", "destination": "/410.html", "statusCode": 410 },
    { "source": "/competitor-playbook-step-1", "destination": "/410.html", "statusCode": 410 },
    { "source": "/bio-optimiser", "destination": "/410.html", "statusCode": 410 },
    { "source": "/e-learning", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/handover-export", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/handover-export.html", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/lens-email", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/lens-email.html", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/lens-handover", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/lens-handover.html", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/lens-work-order", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/lens-work-order.html", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/show-related", "destination": "/410.html", "statusCode": 410 },
    { "source": "/prototypes/show-related.html", "destination": "/410.html", "statusCode": 410 },
    { "source": "/privacy", "destination": "/privacy-policy", "permanent": true },
    { "source": "/dataterms", "destination": "/privacy-policy", "permanent": true }
  ]
}
